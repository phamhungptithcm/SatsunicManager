rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function owner() {
      return request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email in ['hunpeo97@gmail.com', 'phamhung.pitit@gmail.com']
        && firestore.get(/databases/(default)/documents/ownerAccess/$(request.auth.uid)).data.enabled == true
        && firestore.get(/databases/(default)/documents/ownerAccess/$(request.auth.uid)).data.role == 'owner'
        && firestore.get(/databases/(default)/documents/ownerAccess/$(request.auth.uid)).data.email == request.auth.token.email;
    }
    match /owners/{uid}/reports/{reportId}/{file} { allow read: if owner() && request.auth.uid == uid; }
    match /{path=**} { allow read, write: if false; }
  }
}
